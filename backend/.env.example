# ============================================
# TET-A-TET — Пример файла переменных окружения
# Скопируйте этот файл в backend/.env
# и заполните реальными значениями.
# ============================================

# База данных PostgreSQL
# Локально (без Docker) — хост localhost
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tet_a_tet_db
# Внутри Docker — хост db (закомментировано, раскомментировать при деплое)
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/tet_a_tet_db

# Redis (для кэширования)
REDIS_URL=redis://localhost:6379/0

# S3-совместимое хранилище для фото
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Секретный ключ для JWT-токенов
# В продакшене — длинная случайная строка!
SECRET_KEY=change-me-to-a-long-random-string